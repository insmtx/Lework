# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/
frontend/node_modules/

# Build cache
frontend/node_modules/.vite/

# Go workspace file
go.work
go.work.sum

# env file
.env

# OS files
.DS_Store

# Editor/IDE
# .idea/
.vscode/
.DS_Store

.agents/
bundles/
deployments/env/config.yaml
example/
.dsh

.cache/
.turbo/

# Prevent accidental Go source files in root directory (except go.mod/go.sum)
# Note: Actual Go test files should be in backend/tests or appropriate package directories
docs/superpowers

# Swagger generated files (only keep docs/swagger/)
docs/docs.go
docs/swagger.json
docs/swagger.yaml
.worktrees
.worktree
frontend/.pnpm-store
.pnpm-store
/lework
!backend/cmd/lework
logs/
.omo/
.lework-workspace/**
lework-storage/
.codex-local/
.idea
.codegraph
deployments/dev/server.config.yaml
deployments/dev/worker.config.yaml
deployments/helm/lework/values.yaml
.opencode
.cursor
.dsh/
backend/lework

# Control plane browser export is generated before a release build.
frontend/apps/control-plane/.next/
frontend/apps/control-plane/out/
# Expo 本地状态（设备会话、签名 manifest 缓存），不参与构建
frontend/apps/mobile/.expo/
# Next 生成：dev 写 .next/dev/types、build 写 .next/types，跟踪会导致反复脏 diff
frontend/apps/control-plane/next-env.d.ts
backend/internal/controlplane/webui/dist/*
!backend/internal/controlplane/webui/dist/.gitkeep
deployments/dev*/
