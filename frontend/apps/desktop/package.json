{
  "name": "@leros/desktop",
  "version": "0.6.0",
  "description": "Leros desktop application",
  "author": "insmtx",
  "desktopName": "leros-desktop.desktop",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/insmtx/Leros.git",
    "directory": "frontend/apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "build": "pnpm run compile",
    "icons": "node scripts/inject-deploy-config.mjs && node scripts/generate-icons.mjs",
    "dist": "node scripts/dist-local.mjs",
    "dist:private": "node scripts/dist-private.mjs",
    "dist:private:dir": "node scripts/dist-private-target.mjs --dir",
    "dist:private:mac:arm64": "node scripts/dist-private-target.mjs --mac --arm64",
    "dist:private:mac:x64": "node scripts/dist-private-target.mjs --mac --x64",
    "dist:private:win:x64": "node scripts/dist-private-target.mjs --win --x64",
    "dist:private:linux:x64": "node scripts/dist-private-target.mjs --linux --x64",
    "dist:private:linux:arm64": "node scripts/dist-private-target.mjs --linux AppImage:arm64 deb:arm64",
    "dist:dir": "pnpm run icons && pnpm run compile && electron-builder --dir --publish never",
    "dist:mac:arm64": "pnpm run icons && pnpm run compile && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "pnpm run icons && pnpm run compile && electron-builder --mac --x64 --publish never",
    "dist:win:x64": "pnpm run icons && pnpm run compile && electron-builder --win --x64 --publish never",
    "dist:linux:x64": "pnpm run icons && pnpm run compile && electron-builder --linux --x64 --publish never",
    "dist:linux:arm64": "pnpm run icons && pnpm run compile && electron-builder --linux AppImage:arm64 deb:arm64 --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "preview": "electron-vite preview",
    "lint": "biome check .",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@leros/app-ui": "workspace:*",
    "@leros/store": "workspace:*",
    "@leros/styles": "workspace:*",
    "@leros/tsconfig": "workspace:*",
    "@leros/ui": "workspace:*",
    "@rolldown/binding-win32-x64-msvc": "1.0.3",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "^4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0-beta.1",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "png-to-ico": "^2.1.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.6.0",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
