{
  "extends": "@lework/tsconfig/next.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "app",
    "components",
    "lib",
    "**/*.ts",
    "**/*.tsx",
