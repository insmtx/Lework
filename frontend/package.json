{
  "name": "leros-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@leros/web",
    "dev:desktop": "turbo dev --filter=@leros/desktop",
    "build": "turbo build",
    "dist:desktop": "pnpm --filter @leros/desktop dist",
    "dist:desktop:private": "pnpm --filter @leros/desktop dist:private",
    "dist:desktop:private:dir": "pnpm --filter @leros/desktop dist:private:dir",
    "dist:desktop:private:mac:arm64": "pnpm --filter @leros/desktop dist:private:mac:arm64",
    "dist:desktop:private:mac:x64": "pnpm --filter @leros/desktop dist:private:mac:x64",
    "dist:desktop:private:win:x64": "pnpm --filter @leros/desktop dist:private:win:x64",
    "dist:desktop:private:linux:x64": "pnpm --filter @leros/desktop dist:private:linux:x64",
    "dist:desktop:private:linux:arm64": "pnpm --filter @leros/desktop dist:private:linux:arm64",
    "dist:desktop:dir": "pnpm --filter @leros/desktop dist:dir",
    "dist:desktop:mac:arm64": "pnpm --filter @leros/desktop dist:mac:arm64",
    "dist:desktop:mac:x64": "pnpm --filter @leros/desktop dist:mac:x64",
    "dist:desktop:win:x64": "pnpm --filter @leros/desktop dist:win:x64",
    "dist:desktop:linux:x64": "pnpm --filter @leros/desktop dist:linux:x64",
    "dist:desktop:linux:arm64": "pnpm --filter @leros/desktop dist:linux:arm64",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:staged": "lint-staged --cwd .",
    "prepare": "cd .. && husky frontend/.husky",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@leros/biome": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": "biome check --write --no-errors-on-unmatched"
  }
}
