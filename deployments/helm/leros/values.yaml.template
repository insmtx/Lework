# =============================================================================
# Leros Helm Chart 部署配置模板
# =============================================================================
# 此文件由 gen-values.sh 读取并替换占位符后生成 values.yaml，请勿直接编辑。
# 占位符格式：@VAR_NAME@
#   @PG_PASSWORD@         -> 随机生成
#   @NATS_PASSWORD@       -> 随机生成
#   @JWT_SECRET@          -> 随机生成
#   @STORAGE_SIGN_SECRET@ -> 随机生成
#   @REGISTRY@            -> 命令行 --registry 传入，不传则留空
#   @REGISTRY_USER@       -> 命令行 --user 传入
#   @REGISTRY_PASS@       -> 命令行 --pass 传入
# llm.apiKey 不自动生成，需手动填写。
# =============================================================================

# --- 全局覆盖 ---
nameOverride: ""
fullnameOverride: ""

# 宿主机数据根目录：所有组件的 hostPath 默认基于此前缀。
# 各组件 hostPath 字段里的 <dataHostPath> 占位符会被替换为此值。
# 修改这一处即可全局调整所有数据目录位置。
dataHostPath: /data/leros

# 全局节点选择器：postgresql/nats/server/worker 默认回退到此。
# 私有化部署所有组件需固定同一节点让 hostPath 数据共享，填一处即可。
# 组件各自仍可单独覆盖（postgresql.nodeSelector 等）。
nodeSelector: {}
  # kubernetes.io/hostname: node-1

# 命名空间：建议单独 namespace 隔离，默认随 -n 参数
# namespace: leros

# --- 镜像拉取凭证 ---
# 私有镜像仓库认证。enabled=true 时 chart 会创建对应 Secret（kubernetes.io/dockerconfigjson）。
# 如已存在同名 Secret，设 enabled=false 并通过 imagePullSecrets 引用。
imagePullSecret:
  enabled: true
  name: leros-registry
  registry: "@REGISTRY@"
  username: "@REGISTRY_USER@"
  password: "@REGISTRY_PASS@"

# 额外引用已存在的 imagePullSecrets
imagePullSecrets: []
  # - name: leros-registry

# =============================================================================
# PostgreSQL 数据库
# =============================================================================
postgresql:
  enabled: true
  image: postgres:18.4
  username: leros_user
  password: "@PG_PASSWORD@"
  database: leros_db
  hostPath: <dataHostPath>/postgresql
  nodeSelector: {}
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: 1, memory: 1Gi }
  external:
    url: ""

# =============================================================================
# MySQL 数据库（account 服务使用）
# =============================================================================
mysql:
  enabled: false
  image: mysql:8.4
  imagePullPolicy: IfNotPresent
  username: account_user
  password: "@MYSQL_PASSWORD@"
  rootPassword: "@MYSQL_ROOT_PASSWORD@"
  database: account_db
  hostPath: <dataHostPath>/mysql
  nodeSelector: {}
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: 1, memory: 1Gi }
  external:
    # mysql.enabled=false 且 account.reuseCorekg=false 时必填：account 使用的 MySQL 完整 DSN
    # 例：mysql://user:pass@host:3306/db?charset=utf8mb4&parseTime=true&loc=Local
    url: ""

# =============================================================================
# Redis 缓存（account 服务使用）
# =============================================================================
redis:
  enabled: false
  image: redis:7.4
  imagePullPolicy: IfNotPresent
  password: "@REDIS_PASSWORD@"
  hostPath: <dataHostPath>/redis
  nodeSelector: {}
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }
  external:
    # redis.enabled=false 时必填：account 使用的 Redis 地址
    # 例：redis://:pass@host:6379/0
    url: ""

# =============================================================================
# Account 服务（依赖 MySQL 与 Redis；用于统一登录）
# =============================================================================
# 两种部署情况：
#   1) 复用 corekg：reuseCorekg=true，不部署内置 MySQL/Redis，account 连 corekg
#      命名空间下的 MySQL/Redis Service；此时 account 无需初始化（数据在 corekg 侧）。
#   2) 独立部署：reuseCorekg=false（默认），随 chart 部署内置 MySQL/Redis，并通过
#      初始化 Job 执行 --migrate-db + init 完成建表与种子数据。
account:
  enabled: false
  image: account-api:v0.1.0
  imagePullPolicy: IfNotPresent
  replicas: 1
  strategy: Recreate
  containerName: account-api
  env: test
  openDocsApi: true
  logLevel: debug
  logger:
    file:
      enabled: false
      filename: /data/account/log/default.log
      maxSize: 10
      maxAge: 15
      maxBackups: 5
      compress: true
  # reuseCorekg=true 时：直接复用 corekg 命名空间下的 MySQL/Redis，不部署中间件、不初始化。
  reuseCorekg: false
  corekg:
    namespace: corekg-test          # corekg 所在命名空间
    mysqlService: mysql # corekg 的 MySQL Service 名
    redisService: redis # corekg 的 Redis Service 名
    # 以下可覆盖，留空回退到 mysql/redis 顶层值（username/password/database）
    mysqlUsername: "root"
    mysqlPassword: ""
    mysqlDatabase: "leros_db"
    redisPassword: ""
  # 独立部署（reuseCorekg=false）时是否执行初始化 Job（建表 + 种子数据）
  initialize: true
  init:
    issuer: "yygu"                       # IAM_INIT_ISSUER，必填
    jwtSecret: ""                        # IAM_INIT_JWT_SECRET（≥32 字符），生产必改，留空则不注入（用镜像默认）
    company: "default-company"           # IAM_INIT_COMPANY
    adminEmail: "admin@admin.com"        # IAM_INIT_ADMIN_EMAIL，必填
    domain: "localhost"                  # IAM_INIT_DOMAIN
  initCommand:
    binary: account                      # account 镜像内的二进制名
    settingFile: ""                      # 非空则挂载 core_settings.yaml 并传 --setting-file
    settingsConfigMap: ""                # settingFile 非空时必填：含 core_settings.yaml 的 ConfigMap 名
  # account 服务自身的 JWT / 会话配置（写入 config.yaml 的 account 块；jwtSecret 非空才渲染）
  jwtSecret: ""
  pltJwtSecret: ""
  jwtExpire: "8h"
  refreshTokenTtl: "30m"
  loginWindow: "30m"
  serviceNameOverride: ""
  deploymentNameOverride: ""
  configMapNameOverride: ""
  nodeSelector: {}
  resources:
    requests: { cpu: 10m, memory: 64Mi }
    limits: { cpu: 500m, memory: 1Gi }
  service:
    type: ClusterIP
    port: 8080

# =============================================================================
# NATS JetStream 消息队列
# =============================================================================
nats:
  enabled: true
  image: nats:2.12.7
  hostPath: <dataHostPath>/nats
  nodeSelector: {}
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }
  auth:
    enabled: true
    user: leros
    password: "@NATS_PASSWORD@"
  external:
    url: ""

# =============================================================================
# Leros Server（HTTP API 服务，常驻 Deployment）
# =============================================================================
server:
  image: leros:latest
  imagePullPolicy: IfNotPresent
  replicas: 1

  serviceNameOverride: ""
  configMapNameOverride: ""
  deploymentNameOverride: ""

  env: prod
  logLevel: info
  jwtSecret: "@JWT_SECRET@"
  baseUrl: ""
  ginMode: release

  resources:
    requests: { cpu: 200m, memory: 256Mi }
    limits: { cpu: 2, memory: 2Gi }

  service:
    type: ClusterIP
    port: 8080
    nodePort: ""
    loadBalancerIP: ""

  rbac:
    create: true

  extraEnv: []
  logger: {}

# =============================================================================
# Worker 基础设施
# =============================================================================
worker:
  image: leros-worker:latest
  imagePullPolicy: IfNotPresent
  modelrouterDebug: false
  workspaceInitImage: busybox:1.36.1

  configMapNameOverride: ""
  secretNameOverride: ""

  config:
    logLevel: info
    cli:
      default: opencode

  workspaceHostPathRoot: <dataHostPath>/workspace
  workspaceMountRoot: /workspace
  storageHostPath: <dataHostPath>/storage
  storageMountPath: /leros-storage
  nodeSelector: {}
  resources:
    requests: { cpu: 10m, memory: 64Mi }
    limits: { cpu: 1, memory: 1Gi }

# =============================================================================
# Web 前端（可选）
# =============================================================================
web:
  enabled: false
  image: leros-web:latest
  imagePullPolicy: IfNotPresent
  replicas: 1
  apiBaseUrl: ""
  resources:
    requests: { cpu: 100m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }
  service:
    type: ClusterIP
    port: 3000

# =============================================================================
# LLM 配置（外挂，API Key 手动填写）
# =============================================================================
llm:
  apiKey: ""                                   # 必填，手动填写模型 API Key
  provider: openai                             # openai | anthropic | deepseek 等
  model: deepseek-chat                         # 模型名，如 gpt-4o / deepseek-chat / qwen-plus
  baseUrl: "https://api.deepseek.com/v1"       # 模型服务地址，如 https://api.openai.com/v1
  vision: false                                 # 默认模型是否支持图片（多模态）输入，seed 时写入模型配置
  # 采样参数（可选，仅 opencode runtime 生效）。留空则走模型/服务默认；填数字，勿加引号。
  # limit 留空时回退默认 {context:200000, output:16384}。
  top_p: ""                                      # 核采样（0-1），如 0.95
  frequency_penalty: ""                          # 频率惩罚（-2 ~ 2），如 0.1
  presence_penalty: ""                           # 存在惩罚（-2 ~ 2），如 0
  limit:
    context: ""                                  # 上下文窗口大小（token），如 82144
    output: ""                                   # 单次输出上限（token），如 42768
  translation:
    enabled: false
    provider: ""
    model: ""
    baseUrl: ""

# =============================================================================
