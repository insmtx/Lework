# =============================================================================
# Leros Helm Chart 部署配置模板
# =============================================================================
# 此文件由 gen-values.sh 读取并替换占位符后生成 values.yaml，请勿直接编辑。
# 占位符格式：@VAR_NAME@
#   @PG_PASSWORD@         -> 随机生成
#   @NATS_PASSWORD@       -> 随机生成
#   @JWT_SECRET@          -> 随机生成
#   @STORAGE_SIGN_SECRET@ -> 随机生成
#   @REGISTRY@            -> 命令行 --registry 传入，不传则留空
#   @REGISTRY_USER@       -> 命令行 --user 传入
#   @REGISTRY_PASS@       -> 命令行 --pass 传入
# llm.apiKey 不自动生成，需手动填写。
# =============================================================================

# --- 全局覆盖 ---
nameOverride: ""
fullnameOverride: ""

# 宿主机数据根目录：所有组件的 hostPath 默认基于此前缀。
# 各组件 hostPath 字段里的 <dataHostPath> 占位符会被替换为此值。
# 修改这一处即可全局调整所有数据目录位置。
dataHostPath: /data/leros

# 全局节点选择器：postgresql/nats/server/worker 默认回退到此。
# 私有化部署所有组件需固定同一节点让 hostPath 数据共享，填一处即可。
# 组件各自仍可单独覆盖（postgresql.nodeSelector 等）。
nodeSelector: {}
  # kubernetes.io/hostname: node-1

# 命名空间：建议单独 namespace 隔离，默认随 -n 参数
# namespace: leros

# --- 镜像拉取凭证 ---
# 私有镜像仓库认证。enabled=true 时 chart 会创建对应 Secret（kubernetes.io/dockerconfigjson）。
# 如已存在同名 Secret，设 enabled=false 并通过 imagePullSecrets 引用。
imagePullSecret:
  enabled: true
  name: leros-registry
  registry: "@REGISTRY@"
  username: "@REGISTRY_USER@"
  password: "@REGISTRY_PASS@"

# 额外引用已存在的 imagePullSecrets
imagePullSecrets: []
  # - name: insmtx-registry

# =============================================================================
# PostgreSQL 数据库
# =============================================================================
postgresql:
  enabled: true
  image: registry.yygu.cn/library/postgres:18.4
  username: leros_user
  password: "@PG_PASSWORD@"
  database: leros_db
  hostPath: <dataHostPath>/postgresql
  nodeSelector: {}
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: 1, memory: 1Gi }
  external:
    url: ""

# =============================================================================
# NATS JetStream 消息队列
# =============================================================================
nats:
  enabled: true
  image: registry.yygu.cn/library/nats:2.12.7
  hostPath: <dataHostPath>/nats
  nodeSelector: {}
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }
  auth:
    enabled: true
    user: leros
    password: "@NATS_PASSWORD@"
  external:
    url: ""

# =============================================================================
# Leros Server（HTTP API 服务，常驻 Deployment）
# =============================================================================
server:
  image: registry.yygu.cn/insmtx/leros:latest
  imagePullPolicy: IfNotPresent
  replicas: 1

  serviceNameOverride: ""
  configMapNameOverride: ""
  deploymentNameOverride: ""

  env: prod
  logLevel: info
  jwtSecret: "@JWT_SECRET@"
  baseUrl: ""
  ginMode: release

  resources:
    requests: { cpu: 200m, memory: 256Mi }
    limits: { cpu: 2, memory: 2Gi }

  service:
    type: ClusterIP
    port: 8080
    nodePort: ""
    loadBalancerIP: ""

  rbac:
    create: true

  extraEnv: []
  logger: {}

# =============================================================================
# Worker 基础设施
# =============================================================================
worker:
  image: registry.yygu.cn/insmtx/leros-worker:latest
  workspaceInitImage: registry.cn-beijing.aliyuncs.com/yygu/corekg:busybox_1.36.1

  configMapNameOverride: ""
  secretNameOverride: ""

  config:
    logLevel: info
    cli:
      default: leros

  workspaceHostPathRoot: <dataHostPath>/workspace
  workspaceMountRoot: /workspace
  storageHostPath: <dataHostPath>/storage
  storageMountPath: /leros-storage
  nodeSelector: {}
  resources:
    requests: { cpu: 10m, memory: 64Mi }
    limits: { cpu: 1, memory: 1Gi }

# =============================================================================
# Web 前端（可选）
# =============================================================================
web:
  enabled: false
  image: registry.yygu.cn/insmtx/leros-web:latest
  imagePullPolicy: IfNotPresent
  replicas: 1
  apiBaseUrl: ""
  resources:
    requests: { cpu: 100m, memory: 128Mi }
    limits: { cpu: 500m, memory: 512Mi }
  service:
    type: ClusterIP
    port: 3000

# =============================================================================
# LLM 配置（外挂，API Key 手动填写）
# =============================================================================
llm:
  apiKey: ""                                   # 必填，手动填写模型 API Key
  provider: openai                             # openai | anthropic | deepseek 等
  model: deepseek-chat                         # 模型名，如 gpt-4o / deepseek-chat / qwen-plus
  baseUrl: "https://api.deepseek.com/v1"       # 模型服务地址，如 https://api.openai.com/v1
  translation:
    enabled: false
    provider: ""
    model: ""
    baseUrl: ""

# =============================================================================
# Enterprise IAM 认证（仅 enterprise 版本使用）
# =============================================================================
auth:
  enabled: true                                # 是否启用 IAM 企业版认证
  baseUrl: ""                                  # IAM 服务地址，如 https://iam.example.com
  domainName: ""                               # 域名，用于登录配置查询
  phoneCodeLoginEnabled: false                 # 是否开启手机号验证码登录（默认关闭）

# =============================================================================
# 文件存储
# =============================================================================
storage:
  driver: local               # local | s3 | minio
  localDir: /leros-storage
  hostPath: <dataHostPath>/storage
  bucket: leros-bucket
  signSecret: "@STORAGE_SIGN_SECRET@"
  endpoint: ""
  accessKey: ""
  secretKey: ""
  useSSL: false

# =============================================================================
# 客户端版本策略（可选）
# =============================================================================
clientUpdate:
  desktop:
    enabled: false
    minSupportedVersion: "0.1.16"
    latestVersion: "0.1.21"
    updateUrl: ""
    forceMessage: "当前客户端版本过低，请更新后继续使用"

# =============================================================================
# Traefik Ingress Controller（可选，一键开关）
# =============================================================================
# 只需决定是否启用本 chart 的 Traefik，其余全自动：
#   - enabled=false（默认）→ 复用 k3s 自带 Traefik，零配置
#   - enabled=true         → 本 chart 部署独立 Traefik，自动改名（leros-traefik）
#                            + 错端口（8080/8443）与 k3s 自带实例共存，零冲突
# 启用后访问地址：http://<节点IP>:8080（无域名）或 http://<域名>（有域名）
#
# 子 chart 已内置为 charts/traefik-34.2.0.tgz（file://charts，无需 helm dep update）。
# 以下默认值即合规配置，一般无需改动；需特殊调优见 https://traefik.github.io/charts
traefik:
  enabled: false
  image:
  registry: registry.yygu.cn
  repository: rancher/mirrored-library-traefik
  tag: "3.3.6"
  ingressClass:
    name: leros-traefik    # 启用时自动用此名，不与 k3s 的 traefik 撞
  service:
    type: ClusterIP
  ports:
    web:
      hostPort: 8080        # 启用时自动错开 k3s 占用的 80
    websecure:
      hostPort: 8443        # 启用时自动错开 k3s 占用的 443
  resources:
    requests: { cpu: 100m, memory: 128Mi }
    limits: { cpu: 1, memory: 512Mi }

# =============================================================================
# Ingress（默认关闭；需对外暴露时开启）
# =============================================================================
# 开启后自动按 traefik.enabled 选择 IngressClass：
#   - traefik.enabled=false → 用 traefik（k3s 自带）
#   - traefik.enabled=true  → 用 leros-traefik（本 chart 部署）
# 无需手填 ingress.className，除非用 nginx 等其他 Controller 时显式覆盖。
#
# 不用 Traefik（traefik.enabled=false 且无 k3s 自带）时的两种方案：
#   1) NodePort 直接暴露（无域名最简单）：
#        ingress.enabled: false
#        server.service:
#          type: NodePort
#          nodePort: 30080     # http://<节点IP>:30080 访问
#   2) 用集群已有的其他 Controller（如 nginx-ingress）：
#        traefik.enabled: false
#        ingress.enabled: true
#        ingress.className: nginx
ingress:
  enabled: false
  className: ""             # 留空自动跟随；nginx 集群填 nginx 等
  tls: []
  server:
    enabled: true
    # 有域名填域名；默认留空，用 http://<节点IP>:<traefik hostPort> 访问
    host: ""
    annotations: {}
    paths:
      - path: /
        pathType: Prefix
  web:
    enabled: false
    host: ""
    annotations: {}
