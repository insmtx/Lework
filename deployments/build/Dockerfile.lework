ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILD_TAGS=

# The control-plane UI is a static export. Build it before the Go stage so the
# single lework binary embeds the browser app.
FROM registry.yygu.cn/base/node:24 AS ui

WORKDIR /ui
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

COPY frontend/ ./
RUN pnpm install --frozen-lockfile --filter @lework/control-plane...
RUN pnpm --filter @lework/control-plane build

FROM registry.yygu.cn/library/golang:1.25 AS builder

WORKDIR /build

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources
ENV GOPROXY=https://goproxy.cn,direct

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy go mod files first to leverage Docker layer caching with mount cache
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/ \
    go mod download

# Copy source code
COPY . .

# Real UI assets replace the tracked .gitkeep placeholder in the Go stage.
COPY --from=ui /ui/apps/control-plane/out/ /build/backend/internal/controlplane/webui/dist/

ARG TARGETOS
ARG TARGETARCH
ARG BUILD_TAGS

# Build the application with module cache mounted
RUN --mount=type=cache,target=/go/ \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -tags="${BUILD_TAGS}" -ldflags="-s -w" -v -o /build/lework ./backend/cmd/lework/

FROM registry.yygu.cn/insmtx/lework-base:latest

COPY --from=builder /usr/share/zoneinfo/Asia/Shanghai /usr/share/zoneinfo/Asia/Shanghai
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
ENV TZ=Asia/Shanghai

COPY --from=builder /build/lework /lework
COPY --from=builder /build/backend/skills /app/backend/skills
COPY --from=builder /build/deployments/dev/seed /app/deployments/dev/seed

WORKDIR /app

EXPOSE 8080

USER appuser

ENTRYPOINT ["/lework"]
