ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG GO_BUILDER_IMAGE=registry.yygu.cn/library/golang:1.25
ARG BUILD_TAGS=

FROM ${GO_BUILDER_IMAGE} AS builder

WORKDIR /build

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources
ENV GOPROXY=https://goproxy.cn,direct

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    tzdata \
    gcc \
    libc6-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/ \
    go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH
ARG BUILD_TAGS

RUN --mount=type=cache,target=/go/ \
    CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -tags="${BUILD_TAGS}" -ldflags="-s -w" -v -o /build/leros ./backend/cmd/leros/

FROM registry.yygu.cn/insmtx/leros-worker-base:latest

COPY --from=builder /build/leros /leros
COPY --from=builder /build/backend/skills /app/backend/skills

RUN ln -sf /leros /usr/local/bin/leros \
    && mkdir -p /app/config /workspace \
    && chown -R leros:leros /app /workspace /home/leros

WORKDIR /app

ENV LEROS_WORKSPACE_ROOT=/workspace \
    HOME=/home/leros

EXPOSE 8081

USER leros

ENTRYPOINT ["/leros"]
CMD ["worker", "--config", "/app/config/worker.config.yaml", "--workspace-root", "/workspace", "--listen-addr", ":8081"]
