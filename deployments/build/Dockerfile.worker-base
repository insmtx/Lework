FROM registry.yygu.cn/library/ubuntu:24.04

# 构建版次：
#   EDITION=saas     (默认) SaaS 精简版：仅保留投标/Excel/Word/PDF 常用 Python 库，不安装
#                     重型 LaTeX 与音视频处理链，镜像更小。
#   EDITION=private  私有化完整版：含 TeX Live、Poppler、Ghostscript、Pandoc、
#                     ImageMagick、Inkscape、Matplotlib、FFmpeg、Tesseract(含中文 OCR) 等。
# Make 目标 docker-build-worker-base 默认构建 saas；
# docker-build-worker-base-private 以 EDITION=private 构建。
ARG TARGETARCH
ARG EDITION=saas
ARG CLAUDE_CODE_VERSION=latest
ARG CODEX_VERSION=latest
ARG OPENCODE_VERSION=1.17.20
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG NODE_VERSION=22.14.0

# Configure aliyun apt mirrors
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources \
    && sed -i 's|http://security.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources

# 两版共用的基础 apt 包：
# - libreoffice (apt 稳定版，不上 26.8 alpha)：DOCX/DOC/ODT/XLSX/PPTX/PDF 转换与渲染
# - CJK 字体与替代字体：保证中文文档正常渲染
# - python3.12 + python3-pip：文档处理运行时
# - fontconfig、libsqlite3-0 等：基础工具链
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    xz-utils \
    git \
    less \
    bubblewrap \
    libsqlite3-0 \
    libreoffice \
    python3.12 \
    python3-pip \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    fonts-arphic-uming \
    fonts-arphic-ukai \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

# Map common Windows/MS Office CJK font names to the installed Noto/WenQuanYi fonts,
# so LibreOffice documents requesting SimSun/SimHei/FangSong/KaiTi/Microsoft YaHei/
# STSong-Light etc. resolve to real CJK glyphs instead of falling back to DejaVu.
RUN mkdir -p /etc/fonts/conf.d && cat > /etc/fonts/conf.d/30-cjk-aliases.conf <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <!-- Sans (黑体类) -> Noto Sans CJK SC -->
  <match target="pattern"><test name="family"><string>SimHei</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>黑体</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>Microsoft YaHei</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>微软雅黑</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>Source Han Sans CN</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>Source Han Sans SC</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>思源黑体 CN</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Sans CJK SC</string></edit></match>

  <!-- Serif (宋体类) -> Noto Serif CJK SC -->
  <match target="pattern"><test name="family"><string>SimSun</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>宋体</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>NSimSun</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>STSong</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>STSong-Light</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>华文宋体</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>Source Han Serif CN</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>Source Han Serif SC</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>思源宋体 CN</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>

  <!-- FangSong (仿宋) -> Noto Serif CJK SC (closest serif; Ubuntu has no fang-dedicated font) -->
  <match target="pattern"><test name="family"><string>FangSong</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>仿宋</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>STFangsong</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>
  <match target="pattern"><test name="family"><string>华文仿宋</string></test><edit name="family" mode="assign" binding="strong"><string>Noto Serif CJK SC</string></edit></match>

  <!-- KaiTi (楷体) -> AR PL UKai CN (arphic ukai) -->
  <match target="pattern"><test name="family"><string>KaiTi</string></test><edit name="family" mode="assign" binding="strong"><string>AR PL UKai CN</string></edit></match>
  <match target="pattern"><test name="family"><string>楷体</string></test><edit name="family" mode="assign" binding="strong"><string>AR PL UKai CN</string></edit></match>
  <match target="pattern"><test name="family"><string>STKaiti</string></test><edit name="family" mode="assign" binding="strong"><string>AR PL UKai CN</string></edit></match>
  <match target="pattern"><test name="family"><string>华文楷体</string></test><edit name="family" mode="assign" binding="strong"><string>AR PL UKai CN</string></edit></match>
</fontconfig>
EOF

RUN soffice --version \
    && fc-cache -f \
    && fc-list :lang=zh-cn | head -20

# Only install private-edition heavy document/media toolchain:
#   - TeX Live (XeLaTeX/LuaLaTeX/pdfLaTeX + 中文字体)：自定义字体 PDF 排版
#   - Poppler、Ghostscript、Pandoc：PDF 渲染/转换、格式互转
#   - ImageMagick、Inkscape、Matplotlib（含 lib、apt 包）、FFmpeg：图像/矢量图/音视频
#   - Tesseract + eng + chi_sim：OCR（含中文 OCR 语言包）
# SaaS 精简版跳过此段，镜像更小。
RUN if [ "$EDITION" = "private" ]; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        texlive-xetex \
        texlive-luatex \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        texlive-lang-chinese \
        poppler-utils \
        ghostscript \
        pandoc \
        imagemagick \
        inkscape \
        python3-matplotlib \
        ffmpeg \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-chi-sim \
        tesseract-ocr-osd \
        libvips \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Configure pip aliyun mirror and install Python dependencies.
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
# Common Python document-processing libraries (both editions):
#   - python-docx / lxml：DOCX 读写与内部 XML 处理
#   - openpyxl / xlsxwriter / pandas：Excel 读写与分析
#   - python-pptx：PPTX 读写
#   - PyMuPDF / pypdf / pdfplumber / pdfminer.six / reportlab：PDF 处理与生成
#   - Pillow：图像处理
# SaaS 版也装这些轻量库（投标/Excel/Word 技能依赖）。
RUN pip3 install --break-system-packages \
    requests \
    python-docx==1.2.0 \
    lxml==6.0.2 \
    openpyxl==3.1.5 \
    xlsxwriter==3.2.9 \
    pandas==2.2.3 \
    python-pptx==1.0.2 \
    PyMuPDF==1.26.6 \
    pypdf==6.10.0 \
    pdfplumber==0.11.8 \
    pdfminer.six==20251107 \
    reportlab==4.4.9 \
    Pillow==12.2.0
# private 版额外安装 pdfminer.six（上面已装）与 Ghostscript 绑定的 Python 包装暂略；
# 如需 matplotlib 非 apt 版本可在此段补充（apt python3-matplotlib 已能满足基本图表生成）。

# Install Node.js 22 LTS from npmmirror (multi-arch: amd64/arm64)
# NODE_VERSION 由顶层 ARG 提供，不再在 ENV 中重复声明
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) node_arch="x64" ;; \
        arm64) node_arch="arm64" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH:-}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://npmmirror.com/mirrors/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm /tmp/node.tar.xz

# Configure npm npmmirror and install claude-code + codex + opencode
RUN npm config set registry https://registry.npmmirror.com \
    && npm install -g \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "@openai/codex@${CODEX_VERSION}" \
        "opencode-ai@${OPENCODE_VERSION}" \
    && claude --version \
    && codex --version \
    && opencode --version \
    && npm cache clean --force

# Node 文档组件库（两版共用）：docx / PptxGenJS / pdf-lib / sharp。
#体积可控（sharp 走 npm 预编译二进制），技能脚本可直接 require。
RUN npm install -g \
    docx@9.6.1 \
    pptxgenjs@4.0.1 \
    pdf-lib@1.17.1 \
    sharp@0.34.5 \
    && npm cache clean --force

# private 版额外安装 Playwright + Chromium 浏览器（用于 HTML/PDF/截图等场景）。
# SaaS 不装 Playwright（浏览器二进制体积大，SaaS 镜像偏小）。
# 使用 npmmirror 镜像下载 Chromium，避免官方 cdn.playwright.dev 在国内拉取超慢。
RUN if [ "$EDITION" = "private" ]; then \
      npm install -g playwright@1.61.1; \
      PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
      PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright \
      npx --yes playwright@1.61.1 install --with-deps chromium; \
      npm cache clean --force; \
    fi

RUN useradd -m -s /bin/bash leros \
    && mkdir -p /workspace \
    && chown -R leros:leros /workspace /home/leros
