# Lework 一体机环境变量（install.sh 会自动生成 .env；本文件仅作说明）
# 生成后请妥善保管，.env 内含管理员密码与 JWT/存储签名密钥。

# 对外访问
LEROS_BIND_ADDR=0.0.0.0
LEROS_HTTP_PORT=80
# 外部访问地址，用于生成文件下载/预览链接；默认 install.sh 自动探测本机 IP。
LEROS_PUBLIC_BASE_URL=http://192.168.1.10
# 额外允许的跨域来源（逗号分隔）；桌面端/独立前端接入时填写。同源 Web 无需配置。
LEROS_CORS_ALLOWED_ORIGINS=

# 镜像：离线部署时先 docker load，再把这里指向本地镜像 tag。
LEROS_IMAGE=registry.yygu.cn/insmtx/worker:latest
LEROS_WEB_IMAGE=registry.yygu.cn/insmtx/web:latest
LEROS_POSTGRES_IMAGE=postgres:17
LEROS_NATS_IMAGE=nats:2.12
LEROS_NGINX_IMAGE=nginx:1.27-alpine

# 首次启动管理员（仅用户表为空时创建）
LEROS_ADMIN_EMAIL=admin@leros.local
LEROS_ADMIN_PASSWORD=change-me-before-first-boot

# 由 install.sh 生成
LEROS_DB_NAME=leros
LEROS_DB_USER=leros
LEROS_DB_PASSWORD=change-me
LEROS_JWT_SECRET=change-me
LEROS_STORAGE_SECRET=change-me

TZ=Asia/Shanghai
